{#
  HIDDEN: page will not publish while `permalink: false` is set above.
  To re-enable (after Buttondown approval):
    1. Change `permalink: false` → `permalink: /subscribe/`
    2. In _data/csp.js: uncomment the Buttondown entries in `form-action` and `connect-src`
    3. Re-add the footer link in _includes/layouts/base.njk (and post.njk if you want it there too): <a href="/subscribe/">updates</a>
#}

<div class="subscribe-page">
  <h2>stay updated</h2>
  <p class="subscribe-desc">It's turtles all the way down from here 🐢🐢🐢🐢🐢🐢🐢🐢</p>
  <form id="subscribe-form" class="interest-form" action="https://buttondown.com/api/emails/embed-subscribe/lockelol" method="POST" target="popupwindow">
    <input type="hidden" name="embed" value="1">

    <div class="form-field">
      <label for="bd-email">email</label>
      <input type="email" id="bd-email" name="email" required placeholder="you@example.com" autocomplete="email">
    </div>

    <button type="submit">subscribe</button>
  </form>
  <p id="subscribe-msg" class="subscribe-msg" aria-live="polite"></p>
  <p class="subscribe-fineprint">email only. nothing tracked or shared.</p>
</div>

<script csp-hash>
  (function () {
    var form = document.getElementById('subscribe-form');
    var msg = document.getElementById('subscribe-msg');
    var btn = form.querySelector('button[type="submit"]');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var email = document.getElementById('bd-email').value;
      btn.disabled = true;
      fetch(form.action, {
        method: 'POST',
        body: new URLSearchParams({ email: email, embed: '1' }),
        mode: 'no-cors'
      }).finally(function () {
        form.style.display = 'none';
        msg.textContent = "noted. I'll write when there's something worth sending.";
      });
    });
  })();
</script>
